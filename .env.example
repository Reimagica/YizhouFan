# Public website
NEXT_PUBLIC_SITE_URL=https://yizhoufan.com

# Sanity public reads (project ID and dataset are safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-07-27

# Server-only Sanity revalidation (the publication lookup endpoint is read-only)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_WEBHOOK_SECRET=

# DeepSeek: public Q&A only
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Persistent daily quotas for /api/ask on multi-instance Vercel deployments.
# When omitted, development uses an in-memory limiter; production fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random server-only secret used to irreversibly pseudonymize network addresses.
# Generate a long value for production; never expose it with NEXT_PUBLIC_.
RATE_LIMIT_SALT=

# Only this Studio origin may call the public academic metadata lookup endpoint.
SANITY_STUDIO_ORIGIN=https://yizhoufan.sanity.studio

# Daily Google Scholar snapshot sync (server-only).
SERPAPI_API_KEY=
# Vercel Cron sends this value as the Bearer token to the internal sync route.
CRON_SECRET=
