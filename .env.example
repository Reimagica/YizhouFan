# Public website
NEXT_PUBLIC_SITE_URL=https://yizhoufan.com

# Sanity public reads (project ID and dataset are safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-07-27

# Server-only Sanity automation
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_WEBHOOK_SECRET=

# DeepSeek: public Q&A and CMS-assisted summaries/translations
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Persistent daily quotas for /api/ask on multi-instance Vercel deployments.
# When omitted, development uses an in-memory limiter; production fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated private OSS/COS download hosts accepted by the PPTX processor.
# Signed URLs must be short-lived and use HTTPS.
CMS_ALLOWED_PRIVATE_FILE_HOSTS=
